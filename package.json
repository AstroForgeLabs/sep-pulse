{
  "name": "@sep-pulse/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Continuous Anchor Observability & Soroban SLA Registry Platform for Stellar SEPs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "contract:build": "cd contracts/sla_registry && cargo build --target wasm32-unknown-unknown --release",
    "contract:test": "cd contracts/sla_registry && cargo test"
  },
  "keywords": [
    "stellar",
    "soroban",
    "sep",
    "anchor",
    "compliance",
    "sla",
    "monitoring"
  ],
  "author": "Abdulmalik Ojo <abdulmalikojo2@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
