# SEP-Pulse Environment Variables
# Copy this file to .env and fill in your values

# ─── API Server ───────────────────────────────────────────────────────────────
PORT=3001

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Comma-separated list of anchor domains to monitor continuously
MONITORED_ANCHORS=testanchor.stellar.org,ultrastellar.com

# Cron schedule for automatic anchor checks (default: every 15 minutes)
# Uses standard 5-field cron syntax: https://crontab.guru/
MONITOR_CRON_SCHEDULE=*/15 * * * *

# ─── Soroban Contract (Optional) ──────────────────────────────────────────────
# Contract ID of the deployed SLA Registry on Soroban Testnet
# Leave blank to disable on-chain attestation (off-chain only mode)
SOROBAN_CONTRACT_ID=

# Soroban RPC endpoint (default: Testnet)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Admin keypair for submitting on-chain attestations
# IMPORTANT: Never commit real secret keys — use a dedicated test/admin keypair
ADMIN_SECRET_KEY=

# ─── Web Dashboard ────────────────────────────────────────────────────────────
# URL of the API server (consumed by the Next.js web app)
NEXT_PUBLIC_API_URL=http://localhost:3001
